{
  "name": "@ryro-hq/ryro-bot",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --import tsx src/main.ts",
    "admin": "node --import tsx src/admin.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration tests/e2e",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "migrate": "node --import tsx src/migrate.ts",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "commit:check": "node .githooks/commit-message.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "effect": "4.0.0",
    "fflate": "0.8.3",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "oxfmt": "0.71.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
