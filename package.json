{
  "name": "@ryro-hq/ryro-bot",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "admin": "node --env-file-if-exists=.env src/admin.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration tests/e2e",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "hooks:install": "simple-git-hooks",
    "commit:check": "commitlint",
    "prepare": "simple-git-hooks",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "effect": "4.0.0",
    "fflate": "0.8.3",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.1",
    "oxfmt": "0.71.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  },
  "engines": {
    "node": ">=24.12 <27"
  },
  "simple-git-hooks": {
    "commit-msg": "npm run --silent commit:check -- --edit \"$1\"",
    "preserveUnused": true
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "defaultIgnores": false,
    "rules": {
      "scope-empty": [
        2,
        "never"
      ],
      "scope-case": [
        2,
        "always",
        "lower-case"
      ],
      "header-max-length": [
        0
      ],
      "body-max-line-length": [
        0
      ],
      "footer-max-line-length": [
        0
      ],
      "subject-case": [
        0
      ],
      "subject-full-stop": [
        0
      ]
    }
  }
}
