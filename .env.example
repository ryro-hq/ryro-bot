# Copy to .env. All secrets live in ./secrets (never commit that directory).
RYRO_MODE=observe
# Set both to the reviewed full commit SHA used to build the image.
RYRO_POLICY_REVISION=
RYRO_BOT_VERSION=
# App identity is public metadata. Leave unset for bootstrap/observation setup.
GITHUB_APP_ID=
GITHUB_APP_LOGIN=
# Set only after placing the key and installation bindings.
GITHUB_APP_KEY_FILE=
# A localhost/private-network PostgreSQL container is used by Compose.
RYRO_LOCAL_DATABASE=true
BACKUP_AGE_RECIPIENT=
