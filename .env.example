# Configuration and secrets are mounted from an operator-owned directory.
RYRO_MODE=observe
RYRO_WORKERS=4
RYRO_SCHEDULER_SECONDS=300
RYRO_REGISTRY=registry/projects.json
RYRO_POLICY_REVISION=
RYRO_BOT_VERSION=
RYRO_BINDINGS_FILE=/run/secrets/bindings.json
DATABASE_URL_FILE=/run/secrets/database-url
PG_CA_FILE=/run/secrets/postgres-ca.pem
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/webhook-secret
GITHUB_APP_ID=
GITHUB_APP_LOGIN=
GITHUB_APP_KEY_FILE=
