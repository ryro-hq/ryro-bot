{
  "name": "ryro-bot",
  "url": "https://github.com/ryro-hq/ryro-bot",
  "public": false,
  "hook_attributes": {
    "url": "https://REPLACE_WITH_OPERATOR_DOMAIN/github/webhook",
    "active": true
  },
  "redirect_url": "https://github.com/ryro-hq/ryro-bot",
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "actions": "write",
    "checks": "read",
    "metadata": "read"
  },
  "default_events": [
    "push",
    "pull_request",
    "pull_request_review",
    "check_run",
    "check_suite",
    "workflow_run"
  ]
}
